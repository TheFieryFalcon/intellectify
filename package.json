{
  "name": "intellectify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm --filter @intellectify/web sync && vitest run",
    "typecheck": "pnpm -r typecheck",
    "content": "pnpm --filter @intellectify/content build:content",
    "dev": "pnpm content && pnpm --filter @intellectify/web dev",
    "build": "pnpm content && pnpm --filter @intellectify/web build",
    "verify": "pnpm --filter @intellectify/content verify:content",
    "moderation": "node scripts/banned-rules.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "2.8.2",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "jose": "5.9.6"
  }
}
