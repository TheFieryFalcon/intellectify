# The Firebase web config for project intellectify-4357c lives in src/lib/firebase.config.ts.
# These variables are optional overrides (e.g. to point a local build at another project).
# Firebase web config values are public by design; firestore.rules protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
