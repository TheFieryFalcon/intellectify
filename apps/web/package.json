{
  "name": "@intellectify/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "sync": "svelte-kit sync",
    "dev": "node scripts/copy-assets.mjs && vite dev",
    "build": "node scripts/copy-assets.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.15.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@types/dagre": "0.7.52",
    "@types/katex": "0.16.7",
    "jsdom": "25.0.1",
    "svelte": "5.16.0",
    "svelte-check": "4.1.1",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@intellectify/checker": "workspace:*",
    "@intellectify/content": "workspace:*",
    "@intellectify/engine": "workspace:*",
    "dagre": "0.8.5",
    "dompurify": "3.2.3",
    "firebase": "11.1.0",
    "katex": "0.16.11",
    "marked": "15.0.4",
    "mathlive": "0.103.0"
  }
