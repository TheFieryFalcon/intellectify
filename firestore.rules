rules_version = '2';
// Each student can read and write only their own data (docs/SPEC.md §16.2).
// Ratings are computed client-side, so a determined student could edit their own numbers;
// that's accepted for a small group (SPEC §18).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // BANNED-WORDS:START (generated by scripts/banned-rules.mjs from content/banned-words.txt)
    function clean(s) { return !s.lower().matches('(?s).*\\b(nigger|nigga|faggot|fag|retard|retarded|tranny|spic|chink|gook|kike|wetback|coon|raghead|towelhead|paki|dyke|cunt|whore|slut)(s|es|ed|ing)?\\b.*'); }
    // BANNED-WORDS:END

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Leaderboards and profile pages read these (SPEC §12.2–12.3).
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && clean(request.resource.data.displayName)));
    }

    // Daily (later monthly) problem discussions (SPEC §13). A thread document holds counts and the
    // posts' text for search; its posts live under it. Anyone signed in can read and post.
    match /discussions/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'course', 'year', 'questionId', 'posts', 'updatedAt', 'text'])
        && request.resource.data.posts is int
        && request.resource.data.text is string && request.resource.data.text.size() <= 200000
        && clean(request.resource.data.text);

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'body', 'at', 'parent'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 8000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (request.resource.data.parent == null || request.resource.data.parent is string)
          && clean(request.resource.data.body) && clean(request.resource.data.name);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
