rules_version = '2';
// Each student can read and write only their own data (docs/SPEC.md §16.2).
// Ratings are computed client-side, so a determined student could edit their own numbers;
// that's accepted for a small group (SPEC §18).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // BANNED-WORDS:START (generated by packages/content/src/banned-rules.ts from content/banned-words.txt)
    function clean(s) { return !s.lower().matches('(?s).*(^|[^a-z0-9])([n]+[i1!|l]+[g69]+[g69]+[e3]+[r]+|[n]+[i1!|l]+[g69]+[g69]+[a4@]+|[c]+[o0]+[o0]+[n]+|[d]+[a4@]+[r]+[k]+[i1!|l]+[e3]+|[j]+[i1!|l]+[g69]+[a4@]+[b8]+[o0]+[o0]+|([s$]+[a4@]+[m]+[b8]+[o0]+|[5]+[a]+[m]+[b8]+[o0]+)|([g]+[o0]+[l1|i]+[l1|i]+[i1!|l]+[w]+[o0]+[g69]+|[69]+[o]+[l1|i]+[l1|i]+[i1!|l]+[w]+[o0]+[g69]+)|[p]+[o0]+[r]+[c]+[h#]+[^a-z0-9]+[m]+[o0]+[n]+[k]+[e3]+[y]+|([s$]+[p]+[i1!|l]+[c]+|[5]+[p]+[i1!|l]+[c]+)|([b]+[e3]+[a4@]+[n]+[e3]+[r]+|[8]+[e]+[a4@]+[n]+[e3]+[r]+)|[w]+[e3]+[t7+]+[b8]+[a4@]+[c]+[k]+|[c]+[h#]+[i1!|l]+[n]+[k]+|[c]+[h#]+[i1!|l]+[n]+[a4@]+[m]+[a4@]+[n]+|([g]+[o0]+[o0]+[k]+|[69]+[o]+[o0]+[k]+)|[j]+[a4@]+[p]+|([s$]+[l1|i]+[a4@]+[n]+[t7+]+|[5]+[l]+[a4@]+[n]+[t7+]+)[^a-z0-9]+[e3]+[y]+[e3]+|[k]+[i1!|l]+[k]+[e3]+|[y]+[i1!|l]+[d]+|[r]+[a4@]+[g69]+[h#]+[e3]+[a4@]+[d]+|([t+]+[o0]+[w]+[e3]+[l1|i]+[h#]+[e3]+[a4@]+[d]+|[7]+[o]+[w]+[e3]+[l1|i]+[h#]+[e3]+[a4@]+[d]+)|([s$]+[a4@]+[n]+[d]+|[5]+[a]+[n]+[d]+)[^a-z0-9]+[n]+[i1!|l]+[g69]+[g69]+[e3]+[r]+|[p]+[a4@]+[k]+[i1!|l]+|([a@]+[b8]+[o0]+|[4]+[b]+[o0]+)|([b]+[o0]+[o0]+[n]+[g69]+|[8]+[o]+[o0]+[n]+[g69]+)|([l|i]+[u]+[b8]+[r]+[a4@]+|[1]+[u]+[b8]+[r]+[a4@]+)|[h#]+[a4@]+[l1|i]+[f]+[^a-z0-9]+[c]+[a4@]+[s5$]+[t7+]+[e3]+|([g]+[y]+[p]+[p]+[o0]+|[69]+[y]+[p]+[p]+[o0]+)|[p]+[i1!|l]+[k]+[e3]+[y]+|[f]+[a4@]+[g69]+[g69]+[o0]+[t7+]+|[f]+[a4@]+[g69]+|[f]+[a4@]+[g69]+[g69]+[y]+|[d]+[y]+[k]+[e3]+|([l|i]+[e3]+[s5$]+[b8]+[o0]+|[1]+[e]+[s5$]+[b8]+[o0]+)|([t+]+[r]+[a4@]+[n]+[n]+[y]+|[7]+[r]+[a4@]+[n]+[n]+[y]+)|([s$]+[h#]+[e3]+[m]+[a4@]+[l1|i]+[e3]+|[5]+[h]+[e3]+[m]+[a4@]+[l1|i]+[e3]+)|[p]+[o0]+[o0]+[f]+[t7+]+[e3]+[r]+|[h#]+[o0]+[m]+[o0]+|[r]+[e3]+[t7+]+[a4@]+[r]+[d]+|[r]+[e3]+[t7+]+[a4@]+[r]+[d]+[e3]+[d]+|([s$]+[p]+[a4@]+[z2]+|[5]+[p]+[a4@]+[z2]+)|([s$]+[p]+[a4@]+[s5$]+[t7+]+[i1!|l]+[c]+|[5]+[p]+[a4@]+[s5$]+[t7+]+[i1!|l]+[c]+)|[m]+[o0]+[n]+[g69]+[o0]+[l1|i]+[o0]+[i1!|l]+[d]+|([s$]+[p]+[e3]+[r]+[g69]+|[5]+[p]+[e3]+[r]+[g69]+)|[w]+[h#]+[o0]+[r]+[e3]+|([s$]+[l1|i]+[u]+[t7+]+|[5]+[l]+[u]+[t7+]+)|([s$]+[k]+[a4@]+[n]+[k]+|[5]+[k]+[a4@]+[n]+[k]+)|[d]+[i1!|l]+[l1|i]+[d]+[o0]+|[p]+[o0]+[r]+[n]+|[c]+[u]+[m]+|([b]+[l1|i]+[o0]+[w]+[j]+[o0]+[b8]+|[8]+[l]+[o0]+[w]+[j]+[o0]+[b8]+)|[h#]+[a4@]+[n]+[d]+[j]+[o0]+[b8]+|[j]+[i1!|l]+[z2]+[z2]+|[w]+[a4@]+[n]+[k]+|[m]+[a4@]+[s5$]+[t7+]+[u]+[r]+[b8]+[a4@]+[t7+]+[e3]+|[n]+[u]+[d]+[e3]+[s5$]+|[h#]+[e3]+[n]+[t7+]+[a4@]+[i1!|l]+|[m]+[i1!|l]+[l1|i]+[f]+)([s5$]+|[e3]+[s5$]+|[e3]+d|[i1!|l]+ng)?([^a-z0-9]|$).*'); }
    // BANNED-WORDS:END

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Leaderboards and profile pages read these (SPEC §12.2–12.3).
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && clean(request.resource.data.displayName)));
    }

    // Daily (later monthly) problem discussions (SPEC §13). A thread document holds counts and the
    // posts' text for search; its posts live under it. Anyone signed in can read and post.
    match /discussions/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'course', 'year', 'questionId', 'posts', 'updatedAt', 'text'])
        && request.resource.data.posts is int
        && request.resource.data.text is string && request.resource.data.text.size() <= 200000
        && clean(request.resource.data.text);

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'body', 'at', 'parent'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 8000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (request.resource.data.parent == null || request.resource.data.parent is string)
          && clean(request.resource.data.body) && clean(request.resource.data.name);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
