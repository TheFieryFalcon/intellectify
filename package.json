{
  "name": "intellectify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "content": "pnpm --filter @intellectify/content build:content",
    "dev": "pnpm content && pnpm --filter @intellectify/web dev",
    "build": "pnpm content && pnpm --filter @intellectify/web build"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
